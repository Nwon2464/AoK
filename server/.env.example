# Server
PORT=5000
NODE_ENV=development

# MongoDB and local authentication
MONGO_URI=mongodb://127.0.0.1:27017/aok
COOKIE_KEY=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-long-random-string

# Twitch Live API
# Leave both blank when developing only with the Mock API.
CLIENT_ID=
CLIENT_SECRET=

# Google login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK=http://localhost:5000/auth/google/redirect
CLIENT_URL=http://localhost:3000
